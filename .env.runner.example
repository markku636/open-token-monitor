# GitLab runner tokens for deploy/install-runner-macos.ps1 and
# deploy/install-runner-ubuntu.ps1: copy to .env.runner (gitignored) and fill
# in. Never commit a token: whoever has one can run a runner that takes this
# project's build jobs. -Token on the command line wins over this file.
#
# Only needed to register a runner; a runner that is already registered keeps
# its own. A token comes from GitLab: Settings -> CI/CD -> Runners -> New
# project runner (glrt-...). docs/client-build.zh-TW.md has the details.

# Tag macos, Run untagged jobs off.
TM_RUNNER_TOKEN_MACOS=

# Tag ubuntu, Run untagged jobs off, Protected off.
TM_RUNNER_TOKEN_UBUNTU=

# install-runner-ubuntu.ps1 -HubDeploy. Tag hub-deploy, Run untagged jobs off,
# Protected ON: its jobs run the hub server's Docker.
TM_RUNNER_TOKEN_HUB_DEPLOY=
