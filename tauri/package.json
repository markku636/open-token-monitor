{
  "name": "token-monitor-tauri",
  "private": true,
  "version": "0.2.0",
  "description": "Token Monitor 團隊版用戶端（Tauri 2 + Rust）",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc && eslint src && vite build",
    "lint": "eslint src",
    "preview": "vite preview",
    "test": "vitest run",
    "tauri": "tauri",
    "ensure:tokscale": "node scripts/ensure-tokscale.mjs",
    "check:secrets": "node scripts/check-secrets.mjs",
    "test:rust": "cargo test --manifest-path src-tauri/Cargo.toml --no-default-features --lib --bins",
    "lint:rust": "cargo clippy --manifest-path src-tauri/Cargo.toml --no-default-features --all-targets -- -D warnings",
    "test:compat": "node --test \"tests/compat/*.test.mjs\" && vitest run compat",
    "test:scripts": "node --test \"scripts/*.test.mjs\"",
    "verify": "npm run build && npm test && npm run test:scripts && npm run check:secrets && npm run test:rust && npm run lint:rust",
    "verify:shell": "cargo clippy --manifest-path src-tauri/Cargo.toml --all-targets -- -D warnings && cargo test --manifest-path src-tauri/Cargo.toml --lib gui::"
  },
  "dependencies": {
    "@fontsource-variable/inter": "^5.2.8",
    "@tauri-apps/api": "^2.11.0",
    "lucide-react": "^1.21.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "zustand": "^4.5.5"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2.11.3",
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.3.1",
    "autoprefixer": "^10.4.20",
    "eslint": "^10.5.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "postcss": "^8.4.41",
    "tailwindcss": "^3.4.10",
    "typescript": "^5.5.4",
    "typescript-eslint": "^8.62.0",
    "vite": "^5.4.2",
    "vitest": "^4.1.9"
  },
  "engines": {
    "node": ">=22"
  }
}
