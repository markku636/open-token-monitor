{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Token Monitor",
  "mainBinaryName": "token-monitor",
  "version": "0.2.0",
  "identifier": "io.github.markku636.tokenmonitor",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:1420",
    "beforeDevCommand": "npm run ensure:tokscale && npm run dev",
    "beforeBuildCommand": "npm run ensure:tokscale && npm run build"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "Token Monitor",
        "width": 340,
        "height": 560,
        "minWidth": 260,
        "minHeight": 220,
        "decorations": false,
        "transparent": true,
        "shadow": false,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "resizable": true,
        "maximizable": false,
        "minimizable": false,
        "focus": false,
        "visible": false,
        "dragDropEnabled": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; font-src 'self' data:; connect-src ipc: http://ipc.localhost; object-src 'none'; base-uri 'none'",
      "devCsp": null
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "",
      "windows": { "installMode": "passive" }
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "publisher": "Open Token Monitor",
    "copyright": "© 2026 markku636 and contributors. Portions © 2026 Javis (MIT).",
    "shortDescription": "AI 工具用量小工具（Token Monitor 團隊版用戶端）",
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.ico"],
    "externalBin": ["binaries/tokscale"],
    "windows": {
      "webviewInstallMode": { "type": "embedBootstrapper", "silent": true },
      "allowDowngrades": false,
      "nsis": {
        "installMode": "currentUser",
        "languages": ["TradChinese", "English"],
        "displayLanguageSelector": false,
        "startMenuFolder": "Open Token Monitor"
      }
    }
  }
}
