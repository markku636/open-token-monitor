# Token Monitor company client build: copy to .env.client (gitignored) and fill
# in, then `npm run build:client -- --platform win`. Real environment variables
# (GitLab CI/CD variables) win over this file. packaging/build-client.ps1 takes
# the hub URL and client key from the hub's .env.ubuntu first, so those two can
# stay empty here for a local build. docs/client-build.zh-TW.md has the details.

# The hub the installed client connects to. https is required unless
# TM_CLIENT_ALLOW_HTTP=1 (the hub on port 80 is plain http).
TM_CLIENT_HUB_URL=
TM_CLIENT_ALLOW_HTTP=0

# One of the hub's client keys (TOKEN_MONITOR_CLIENT_SECRETS). Never the admin
# key TOKEN_MONITOR_SECRET: anyone with the installer can read this value.
TM_CLIENT_SECRET=

# Upload to the hub every 30 minutes. Allowed: 0 (live), 600000, 1200000,
# 1800000.
TM_CLIENT_SYNC_UPLOAD_INTERVAL_MS=1800000

# Launch at login on first install (1 or 0).
TM_CLIENT_START_AT_LOGIN=1

# The launch at login minimizes the widget to the taskbar (1, the default), or
# shows it, as upstream does (0). A launch by hand always shows it.
# TM_CLIENT_START_MINIMIZED=1

# The widget shows this machine's usage only (1, the default), or every device
# on the hub, as upstream does (0). Uploads are the same either way.
# TM_CLIENT_OWN_DEVICE_ONLY=1

# Where the app looks for updates: the newest Release of this GitLab project
# (Windows and Linux; macOS has none). Set both or neither; neither leaves the
# app without an update source. CI passes $CI_PROJECT_URL and $CI_PROJECT_ID.
TM_CLIENT_UPDATE_PROJECT_URL=https://gitlab.example.com/tools/token-monitor
TM_CLIENT_UPDATE_PROJECT_ID=42

# X.Y.Z-corp.N, X.Y.Z being the upstream version. Empty: X.Y.Z-corp.0, or with
# packaging/build-client.ps1 the next N after release\client\ and the tags. CI takes
# it from the tag client-vX.Y.Z-corp.N.
TM_CLIENT_VERSION=
