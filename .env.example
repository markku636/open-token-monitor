# Token Monitor company hub: copy to .env (gitignored) and fill in.
# `npm run hub` and `docker compose -f docker/compose.yml --env-file .env` read
# the same file. docs/hub.zh-TW.md lists every setting. Use long random hex values:
#   node -e "console.log(require('crypto').randomBytes(24).toString('hex'))"

# Admin key: everything, including the dashboard's admin sections. Never hand
# it to users.
TOKEN_MONITOR_SECRET=

# Client key(s), comma separated: what users type into the upstream client
# (Settings → Multi-device Sync) together with the hub URL. Upload and read
# only. List two during a rotation.
TOKEN_MONITOR_CLIENT_SECRETS=

# PostgreSQL started by docker/compose.yml (docs/postgres.zh-TW.md). These
# three only take effect when its volume is created.
POSTGRES_PASSWORD=
TOKEN_MONITOR_DB_PASSWORD=
# Optional: a read-only login (token_monitor_reader) for reporting tools.
TOKEN_MONITOR_DB_READONLY_PASSWORD=

# PostgreSQL is published on the host's loopback only. 0.0.0.0 lets other
# machines connect: run deploy/postgres-lan-firewall.sh on the host first,
# because ufw does not filter Docker's published ports (docs/postgres.zh-TW.md).
# POSTGRES_HOST_BIND=0.0.0.0

# Outside Compose (npm run hub), or against a PostgreSQL that IT runs:
# TOKEN_MONITOR_DATABASE_URL=postgres://token_monitor:<password>@127.0.0.1:5432/token_monitor

# docker/compose.yml publishes the hub on the host's port 80. Another port
# when 80 is taken (not TOKEN_MONITOR_PORT: `npm run hub` listens on that).
# TOKEN_MONITOR_HOST_PORT=8080

# The dashboard shows company-wide usage without a key when set to 1.
# TOKEN_MONITOR_PUBLIC_DASHBOARD=1

# Where the dashboard's "下載 Token Monitor" button leads: the company client's
# GitLab Releases. Empty: no button.
TOKEN_MONITOR_CLIENT_DOWNLOAD_URL=https://gitlab.example.com/tools/token-monitor/-/releases

# The hub's own database backups (pg_dump into the hub-backups volume): the
# hour, in UTC, of the daily one (19 = 03:00 in Taipei), and how many daily
# ones to keep (0: no daily backups; an admin can still make one).
# TOKEN_MONITOR_BACKUP_HOUR=19
# TOKEN_MONITOR_BACKUP_KEEP=14
