meta {
  name: Stats
  type: http
  seq: 4
}

get {
  url: {{baseUrl}}/api/stats
  body: none
  auth: bearer
}

auth:bearer {
  token: {{clientKey}}
}

tests {
  test("stats readable with client key", function() {
    expect(res.getStatus()).to.equal(200);
    expect(res.getBody().periods).to.be.an("object");
  });
}
