meta {
  name: Devices
  type: http
  seq: 5
}

get {
  url: {{baseUrl}}/api/devices
  body: none
  auth: bearer
}

auth:bearer {
  token: {{clientKey}}
}

tests {
  test("device list readable", function() {
    expect(res.getStatus()).to.equal(200);
    expect(res.getBody().devices).to.be.an("array");
  });
}
